{
  "name": "kloomie-desktop",
  "productName": "Kloomie",
  "version": "0.1.0",
  "description": "Drop anything. It shows up on every device.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kloomie.desktop",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "icon.png",
      "tray.png",
      "trayTemplate@2x.png",
      "drag.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Kloomie records your microphone when you record a meeting.",
        "NSAudioCaptureUsageDescription": "Kloomie records your computer's sound when you record a meeting, so both sides of a call are heard."
      },
      "icon": "icon.png",
      "artifactName": "Kloomie-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "Kloomie-windows-setup.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "icon.png",
      "artifactName": "Kloomie-linux.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "whirleyjoshua-netizen",
      "repo": "Column",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@44.7.2": true
  }
}
